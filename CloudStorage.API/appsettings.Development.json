{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedOrigins": [
    "http://localhost:4200",
    "http://localhost:5274"
  ],
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5433;Database=CloudStorageDb;Username=postgres;Password=yourpassword"
  },
  "Jwt": {
    "Key": "ThisIsASuperSecretKeyForDevelopmentOnlyDoNotUseInProduction123",
    "Issuer": "CloudStorageApi",
    "Audience": "CloudStorageClients",
    "ExpirationMinutes": 60
  },
  "AzureBlob": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "cloudstorage-chunks",
    "SasTokenExpiryMinutes": 60
  },
  "RefreshToken": {
    "ExpirationDays": 30
  }
}
