{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:4200",
    "http://localhost:3000"
  ],
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=CloudStorageDb;Username=postgres;Password=yourpassword"
  },
  "Jwt": {
    "Key": "ThisIsASuperSecretKeyThatShouldBeLongEnoughForHS256Algorithm",
    "Issuer": "CloudStorageApi",
    "Audience": "CloudStorageClients",
    "ExpirationMinutes": 15
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "UserName": "guest",
    "Password": "guest"
  },
  "CDN": {
    "BaseUrl": "https://cdn.example.com",
    "CacheTTLSeconds": 86400
  },
  "Cache": {
    "DefaultTTLMinutes": 60
  },
  "RefreshToken": {
    "ExpirationDays": 7
  },
  "PasswordReset": {
    "TokenExpirationMinutes": 60,
    "ResetUrl": "http://localhost:4200/auth/reset-password"
  },
  "Smtp": {
    "Host": "mailpit",
    "Port": 1025,
    "FromAddress": "noreply@cloudstorage.local",
    "FromName": "Cloud Storage Local"
  },
  "FileUpload": {
    "MaxFileSizeBytes": 53687091200,
    "AllowedContentTypes": [
      "image/*",
      "video/*",
      "application/pdf",
      "application/zip",
      "text/*"
    ]
  },
  "StorageProvider": {
    "Active": "MinIO",
    "PresignedUrlExpiryMinutes": 15,
    "Azure": {
      "ConnectionString": "UseDevelopmentStorage=true",
      "ContainerName": "cloudstorage-chunks"
    },
    "S3": {
      "BucketName": "cloudstorage-chunks",
      "Region": "us-east-1",
      "ServiceURL": "",
      "AccessKey": "",
      "SecretKey": ""
    },
    "MinIO": {
      "Endpoint": "minio:9000",
      "AccessKey": "minioadmin",
      "SecretKey": "minioadmin",
      "BucketName": "cloudstorage-chunks",
      "UseSSL": false
    },
    "Local": {
      "BasePath": "/app/storage/chunks",
      "BaseUrl": "http://localhost:5000"
    }
  },
  "Security": {
    "MasterKey": "default-antigravity-master-key-must-be-32-bytes-long!"
  }
}
