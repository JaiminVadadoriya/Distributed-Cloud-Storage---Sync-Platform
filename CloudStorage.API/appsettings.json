{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:4200",
    "http://localhost:3000"
  ],
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=CloudStorageDb;Username=postgres;Password=yourpassword"
  },
  "Jwt": {
    "Key": "ThisIsASuperSecretKeyThatShouldBeLongEnoughForHS256Algorithm",
    "Issuer": "CloudStorageApi",
    "Audience": "CloudStorageClients",
    "ExpirationMinutes": 15
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "UserName": "guest",
    "Password": "guest"
  },
  "CDN": {
    "BaseUrl": "https://cdn.example.com",
    "CacheTTLSeconds": 86400
  },
  "Cache": {
    "DefaultTTLMinutes": 60
  },
  "RefreshToken": {
    "ExpirationDays": 7
  },
  "PasswordReset": {
    "TokenExpirationMinutes": 60,
    "ResetUrl": "http://localhost:4200/auth/reset-password"
  },
  "Smtp": {
    "Host": "mailpit",
    "Port": 1025,
    "FromAddress": "noreply@cloudstorage.local",
    "FromName": "Cloud Storage Local"
  },
  "FileUpload": {
    "MaxFileSizeBytes": 53687091200,
    "AllowedContentTypes": [
      "image/*",
      "video/*",
      "application/pdf",
      "application/zip",
      "text/*"
    ]
  },
  "AzureBlob": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "cloudstorage-chunks",
    "SasTokenExpiryMinutes": 15,
    "EncryptionScope": ""
  }
}
