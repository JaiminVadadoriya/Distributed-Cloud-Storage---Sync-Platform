MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=cloudstorage-chunks

# RabbitMQ credentials
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Grafana admin credentials
GRAFANA_ADMIN_PASSWORD=admin
