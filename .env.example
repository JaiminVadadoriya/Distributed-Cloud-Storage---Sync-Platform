# PostgreSQL credentials
DB_PASSWORD=yourpassword
DB_USER=postgres
DB_NAME=CloudStorageDb

# JWT Settings
JWT_KEY=ThisIsASuperSecretKeyThatShouldBeLongEnoughForHS256Algorithm
JWT_ISSUER=CloudStorageApi
